{
  "name": "mute-bundesliga",
  "version": "0.0.6",
  "private": true,
  "description": "Create a regular expression for muting Bundesliga matches in social media apps.",
  "license": "MIT",
  "repository": "github:mrcgrtz/mute-bundesliga",
  "author": "Marc Görtz <git@marcgoertz.de> (https://marcgoertz.de/)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npx eleventy --input=src --output=dist --formats=11ty.js,njk",
    "format": "xo --fix",
    "test": "xo && c8 ava",
    "coverage": "c8 report --reporter=lcov"
  },
  "files": [
    "scripts/cli.mjs",
    "src/mute.js"
  ],
  "keywords": [
    "bundesliga",
    "mute",
    "mumble",
    "regex"
  ],
  "dependencies": {
    "meow": "^14.1.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "execa": "^10.0.1",
    "xo": "^5.0.1"
  }
}
